<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>LinkLoom Trello Power-Up</title>
    <script src="https://p.trellocdn.com/power-up.min.js"></script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: transparent;
      }
    </style>
  </head>
  <body>
    <script>
      // Initialize LinkLoom Power-Up
      TrelloPowerUp.initialize({
        // Show board button to connect LinkLoom
        'board-buttons': function (t, opts) {
          return [{
            icon: {
              dark: 'data:image/svg+xml;base64,',
              light: 'data:image/svg+xml;base64,'
            },
            text: 'LinkLoom',
            callback: function (t) {
              return t.popup({
                title: 'Connect to LinkLoom',
                url: './popup.html',
                height: 500
              });
            }
          }];
        },

        // Show card buttons for content management
        'card-buttons': function (t, opts) {
          return [{
            icon: {
              dark: 'data:image/svg+xml;base64,',
              light: 'data:image/svg+xml;base64,'
            },
            text: 'Add to Bio',
            callback: function (t) {
              return t.popup({
                title: 'Add to LinkLoom Bio',
                url: './card-popup.html',
                height: 400
              });
            }
          }];
        },

        // Show card badges for LinkLoom status
        'card-badges': function (t, opts) {
          return t.get('card', 'shared', 'linkloom_status')
            .then(function (status) {
              if (status === 'synced') {
                return [{
                  text: '✓ Bio',
                  icon: 'data:image/svg+xml;base64,',
                  color: 'green'
                }];
              } else if (status === 'pending') {
                return [{
                  text: '⏳ Bio',
                  icon: 'data:image/svg+xml;base64,',
                  color: 'yellow'
                }];
              }
              return [];
            });
        },

        // Show board badges for integration status
        'board-badges': function (t, opts) {
          return t.get('board', 'shared', 'linkloom_connected')
            .then(function (connected) {
              if (connected) {
                return [{
                  text: 'LinkLoom Connected',
                  icon: 'data:image/svg+xml;base64,',
                  color: 'green'
                }];
              }
              return [];
            });
        }
      });
    </script>
  </body>
</html>
